# ============================
# 九键输入法项目 .gitignore
# ============================

# ---- 构建/安装包产物 ----
*.exe
output/
archives/
*.zip
*.7z
*.msi

# ---- 第三方工具链(不入库,体积大) ----
py32/
nsis*/
NSIS/

# ---- 日志与测试输出 ----
*.log
*.tmp
test_output.*
tpos_test.*

# ---- 截图与临时图片(开发过程记录用,不入库) ----
*.png
*.jpg
*.bmp
*.gif

# ---- 临时目录/杂项 ----
$d/
~$*
Thumbs.db
desktop.ini

# ---- 编辑器/IDE ----
.vs/
.vscode/
*.user
*.suo
